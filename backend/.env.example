# Copy to .env for local dev. In prod these come from the platform (Container Apps).
NODE_ENV=development
PORT=8080

# Postgres — co-locate with the app in ONE region in prod (v1 lesson).
DATABASE_URL=postgres://church:secret@localhost:5432/church_hub

# Auth — generate strong random values in prod (openssl rand -base64 48).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS: the SPA origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173

# White-label defaults used only to seed the first organisation row.
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
