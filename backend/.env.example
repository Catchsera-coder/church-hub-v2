# Copy to .env for local dev. In prod these come from the platform (Container Apps).
NODE_ENV=development
PORT=8080

# Postgres — co-locate with the app in ONE region in prod (v1 lesson).
DATABASE_URL=postgres://church:secret@localhost:5432/church_hub

# Auth — generate strong random values in prod (openssl rand -base64 48).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS: the SPA origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173

# White-label defaults used only to seed the first organisation row.
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# Messaging (all optional, per-deploy). Leave blank to disable a channel — in prod,
# unconfigured channels report delivery FAILURE honestly instead of faking 'sent'.
# In dev, they just log to the console. Providers are called over HTTP (no SDK dep).
# Email — SendGrid:
MAIL_FROM=
SENDGRID_API_KEY=

# SMS — choose Twilio OR Azure Communication Services. Leave SMS_PROVIDER blank to
# auto-pick whichever is configured (Azure preferred if both); set it to force one.
SMS_PROVIDER=
# Option A — Twilio (SMS_FROM is your Twilio number in E.164, e.g. +15551234567):
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Option B — Azure Communication Services (ACS_SMS_FROM is your ACS number, E.164):
ACS_CONNECTION_STRING=
ACS_SMS_FROM=
